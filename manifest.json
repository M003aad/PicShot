{
  "manifest_version": 3,
  "name": "PicShot",
  "version": "1.0.0",
  "description": "Take fullscreen or area screenshots quickly",
  "permissions": [
    "tabs",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
